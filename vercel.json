{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "tourstarapp.com" }], "destination": "/landing.html" },
    { "source": "/", "has": [{ "type": "host", "value": "www.tourstarapp.com" }], "destination": "/landing.html" },
    { "source": "/landing", "destination": "/landing.html" },
    { "source": "/((?!assets/|landing/).*)", "destination": "/index.html" }
  ]
}
