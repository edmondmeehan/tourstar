{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/admin",
      "destination": "/play/admin",
      "permanent": false
    },
    {
      "source": "/landing",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/play",
      "destination": "/play.html"
    },
    {
      "source": "/play/:path*",
      "destination": "/play.html"
    },
    {
      "source": "/investors",
      "destination": "/investors/index.html"
    },
    {
      "source": "/investors/:page([a-z-]+)",
      "destination": "/investors/:page.html"
    },
    {
      "source": "/((?!assets/|landing/|brand/|investors).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/play(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/investors(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
