{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/admin", "destination": "/play/admin", "permanent": false },
    { "source": "/landing", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/landing.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/play", "destination": "/index.html" },
    { "source": "/play/:path*", "destination": "/index.html" },
    { "source": "/((?!assets/|landing/|brand/).*)", "destination": "/landing.html" }
  ],
  "headers": [
    { "source": "/play(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
